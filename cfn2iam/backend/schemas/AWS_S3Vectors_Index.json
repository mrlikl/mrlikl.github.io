{
  "handlers": {
    "create": {
      "permissions": [
        "s3vectors:GetIndex",
        "s3vectors:CreateIndex",
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ]
    },
    "delete": {
      "permissions": [
        "s3vectors:GetIndex",
        "s3vectors:DeleteIndex"
      ]
    },
    "list": {
      "handlerSchema": {
        "oneOf": [
          {
            "required": [
              "VectorBucketName"
            ]
          },
          {
            "required": [
              "VectorBucketArn"
            ]
          }
        ],
        "properties": {
          "VectorBucketArn": {
            "$ref": "resource-schema.json#/properties/VectorBucketArn"
          },
          "VectorBucketName": {
            "$ref": "resource-schema.json#/properties/VectorBucketName"
          }
        }
      },
      "permissions": [
        "s3vectors:ListIndexes"
      ]
    },
    "read": {
      "permissions": [
        "s3vectors:GetIndex"
      ]
    }
  },
  "typeName": "AWS::S3Vectors::Index"
}