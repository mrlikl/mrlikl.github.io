{
  "handlers": {
    "create": {
      "permissions": [
        "lambda:CreateCapacityProvider",
        "lambda:GetCapacityProvider",
        "lambda:TagResource",
        "iam:PassRole",
        "iam:CreateServiceLinkedRole",
        "kms:DescribeKey"
      ]
    },
    "delete": {
      "permissions": [
        "lambda:DeleteCapacityProvider",
        "lambda:GetCapacityProvider"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "State": {
            "description": "The current state of the capacity provider. Indicates whether the provider is being created, is active and ready for use, has failed, or is being deleted.",
            "enum": [
              "Pending",
              "Active",
              "Failed",
              "Deleting"
            ],
            "type": "string"
          }
        }
      },
      "permissions": [
        "lambda:ListCapacityProviders"
      ]
    },
    "read": {
      "permissions": [
        "lambda:GetCapacityProvider",
        "lambda:ListTags"
      ]
    },
    "update": {
      "permissions": [
        "lambda:UpdateCapacityProvider",
        "lambda:TagResource",
        "lambda:UntagResource"
      ]
    }
  },
  "typeName": "AWS::Lambda::CapacityProvider"
}