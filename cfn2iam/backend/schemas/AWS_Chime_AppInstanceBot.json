{
  "handlers": {
    "create": {
      "permissions": [
        "chime:CreateAppInstanceBot",
        "chime:DescribeAppInstanceBot",
        "chime:TagResource",
        "chime:ListTagsForResource"
      ]
    },
    "delete": {
      "permissions": [
        "chime:DeleteAppInstanceBot",
        "chime:DescribeAppInstanceBot"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "AppInstanceArn": {
            "maxLength": 1600,
            "minLength": 5,
            "pattern": "^arn:[a-z0-9-\\.]{1,63}:[a-z0-9-\\.]{0,63}:[a-z0-9-\\.]{0,63}:[a-z0-9-\\.]{0,63}:[^/].{0,1023}$",
            "type": "string"
          }
        },
        "required": [
          "AppInstanceArn"
        ]
      },
      "permissions": [
        "chime:ListAppInstanceBots"
      ]
    },
    "read": {
      "permissions": [
        "chime:DescribeAppInstanceBot",
        "chime:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "chime:UpdateAppInstanceBot",
        "chime:DescribeAppInstanceBot",
        "chime:TagResource",
        "chime:UntagResource",
        "chime:ListTagsForResource"
      ]
    }
  },
  "typeName": "AWS::Chime::AppInstanceBot"
}