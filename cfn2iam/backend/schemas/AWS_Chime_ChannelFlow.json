{
  "handlers": {
    "create": {
      "permissions": [
        "chime:CreateChannelFlow",
        "chime:DescribeChannelFlow",
        "chime:TagResource"
      ]
    },
    "delete": {
      "permissions": [
        "chime:DeleteChannelFlow",
        "chime:DescribeChannelFlow"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "AppInstanceArn": {
            "description": "The ARN of the app instance.",
            "maxLength": 1600,
            "minLength": 5,
            "pattern": "^arn:[a-z0-9-\\.]{1,63}:[a-z0-9-\\.]{0,63}:[a-z0-9-\\.]{0,63}:[a-z0-9-\\.]{0,63}:[^/].{0,1023}$",
            "type": "string"
          }
        },
        "required": [
          "AppInstanceArn"
        ]
      },
      "permissions": [
        "chime:ListChannelFlows"
      ]
    },
    "read": {
      "permissions": [
        "chime:DescribeChannelFlow",
        "chime:ListTagsForResource"
      ]
    },
    "update": {
      "permissions": [
        "chime:UpdateChannelFlow",
        "chime:DescribeChannelFlow",
        "chime:TagResource",
        "chime:UntagResource",
        "chime:ListTagsForResource"
      ]
    }
  },
  "typeName": "AWS::Chime::ChannelFlow"
}