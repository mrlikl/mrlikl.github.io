        "iam:PassRole",
        "qldb:StreamJournalToKinesis",
        "qldb:DescribeJournalKinesisStream"
      ]
    },
    "delete": {
      "permissions": [
        "qldb:CancelJournalKinesisStream",
        "qldb:DescribeJournalKinesisStream"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "LedgerName": {
            "type": "string"
          }
