{
  "handlers": {
    "create": {
      "permissions": [
        "sagemaker:CreateClusterExtension",
        "sagemaker:DescribeClusterExtension",
        "sagemaker:AddTags",
        "sagemaker:ListTags"
      ]
    },
    "delete": {
      "permissions": [
        "sagemaker:DeleteClusterExtension",
        "sagemaker:DescribeClusterExtension"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "ClusterArn": {
            "maxLength": 256,
            "minLength": 0,
            "pattern": "^arn:aws[a-z\\-]*:sagemaker:[a-z0-9\\-]*:[0-9]{12}:cluster/[a-z0-9]{12}$",
            "type": "string"
          }
        },
        "required": [
          "ClusterArn"
        ]
      },
      "permissions": [
        "sagemaker:ListClusterExtensions"
      ]
    },
    "read": {
      "permissions": [
        "sagemaker:DescribeClusterExtension",
        "sagemaker:ListTags"
      ]
    },
    "update": {
      "permissions": [
        "sagemaker:UpdateClusterExtension",
        "sagemaker:DescribeClusterExtension",
        "sagemaker:AddTags",
        "sagemaker:DeleteTags",
        "sagemaker:ListTags"
      ]
    }
  },
  "typeName": "AWS::SageMaker::Extension"
}