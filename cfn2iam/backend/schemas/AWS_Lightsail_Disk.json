{
  "handlers": {
    "create": {
      "permissions": [
        "lightsail:CreateDisk",
        "lightsail:EnableAddOn",
        "lightsail:DisableAddOn",
        "lightsail:GetDisk",
        "lightsail:GetDisks",
        "lightsail:GetRegions",
        "lightsail:TagResource",
        "lightsail:UntagResource"
      ]
    },
    "delete": {
      "permissions": [
        "lightsail:GetDisk",
        "lightsail:GetDisks",
        "lightsail:DeleteDisk"
      ]
    },
    "list": {
      "permissions": [
        "lightsail:GetDisks"
      ]
    },
    "read": {
      "permissions": [
        "lightsail:GetDisk",
        "lightsail:GetDisks"
      ]
    },
    "update": {
      "permissions": [
        "lightsail:GetDisk",
        "lightsail:GetDisks",
        "lightsail:EnableAddOn",
        "lightsail:DisableAddOn",
        "lightsail:TagResource",
        "lightsail:UntagResource"
      ],
      "timeoutInMinutes": 2160
    }
  },
  "typeName": "AWS::Lightsail::Disk"
}