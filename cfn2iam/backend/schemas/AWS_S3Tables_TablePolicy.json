{
  "handlers": {
    "create": {
      "permissions": [
        "s3tables:GetTablePolicy",
        "s3tables:PutTablePolicy",
        "s3tables:GetTable"
      ]
    },
    "delete": {
      "permissions": [
        "s3tables:GetTablePolicy",
        "s3tables:DeleteTablePolicy",
        "s3tables:GetTable"
      ]
    },
    "list": {
      "handlerSchema": {
        "properties": {
          "Namespace": {
            "description": "The namespace that the table belongs to.",
            "type": "string"
          },
          "TableBucketARN": {
            "description": "The Amazon Resource Name (ARN) of the specified table bucket.",
            "examples": [
              "arn:aws:s3tables:us-west-2:123456789012:bucket/mytablebucket"
            ],
            "type": "string"
          }
        },
        "required": [
          "TableBucketARN"
        ]
      },
      "permissions": [
        "s3tables:ListTables",
        "s3tables:GetTablePolicy"
      ]
    },
    "read": {
      "permissions": [
        "s3tables:GetTable",
        "s3tables:GetTablePolicy"
      ]
    },
    "update": {
      "permissions": [
        "s3tables:GetTablePolicy",
        "s3tables:PutTablePolicy",
        "s3tables:GetTable"
      ]
    }
  },
  "typeName": "AWS::S3Tables::TablePolicy"
}