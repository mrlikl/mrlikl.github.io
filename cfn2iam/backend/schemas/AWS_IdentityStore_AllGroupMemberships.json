{
  "handlers": {
    "list": {
      "handlerSchema": {
        "properties": {
          "GroupId": {
            "maxLength": 47,
            "minLength": 1,
            "pattern": "^([0-9a-f]{10}-|)[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$",
            "type": "string"
          },
          "IdentityStoreId": {
            "maxLength": 36,
            "minLength": 1,
            "pattern": "^d-[0-9a-f]{10}$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "IdentityStoreId",
          "GroupId"
        ]
      },
      "permissions": [
        "identitystore:ListGroupMemberships"
      ]
    },
    "read": {
      "permissions": [
        "identitystore:DescribeGroupMembership"
      ]
    }
  },
  "typeName": "AWS::IdentityStore::AllGroupMemberships"
}