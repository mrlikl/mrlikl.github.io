    "aws:ResourceTag/${TagKey}"
   ]
  },
  "packaging-groups": {
   "arnFormats": [
    "arn:${Partition}:mediapackage-vod:${Region}:${Account}:packaging-groups/${PackagingGroupIdentifier}"
   ],
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ]
  }
 },
 "service": "mediapackage-vod",
 "serviceName": "MediaPackage VOD",
 "version": "v1.5"
}
