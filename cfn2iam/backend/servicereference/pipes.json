 },
 "conditionKeys": {
  "aws:RequestTag/${TagKey}": [
   "String"
  ],
  "aws:ResourceTag/${TagKey}": [
   "String"
  ],
  "aws:TagKeys": [
   "ArrayOfString"
  ]
 },
 "resources": {
  "pipe": {
   "arnFormats": [
    "arn:${Partition}:pipes:${Region}:${Account}:pipe/${Name}"
   ],
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ]
  }
 },
 "service": "pipes",
 "serviceName": "EventBridge Pipes",
 "version": "v1.5"
}
