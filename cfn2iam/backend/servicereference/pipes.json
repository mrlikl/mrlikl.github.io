   ],
   "flags": [
    "IsTaggingOnly",
    "IsWrite"
   ],
   "name": "TagResource",
   "resources": [
    "pipe"
   ]
  },
  "untagresource": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}",
    "aws:TagKeys"
   ],
   "flags": [
    "IsTaggingOnly",
    "IsWrite"
   ],
   "name": "UntagResource",
   "resources": [
    "pipe"
   ]
  },
  "updatepipe": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
