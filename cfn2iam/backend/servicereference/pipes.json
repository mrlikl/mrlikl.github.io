   ],
   "name": "CreatePipe",
   "resources": [
    "pipe"
   ]
  },
  "deletepipe": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ],
   "flags": [
    "IsWrite"
   ],
   "name": "DeletePipe",
   "resources": [
    "pipe"
   ]
  },
  "describepipe": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ],
   "name": "DescribePipe",
   "resources": [
    "pipe"
   ]
  },
  "listpipes": {
   "flags": [
    "IsList"
   ],
   "name": "ListPipes",
   "resources": []
  },
  "listtagsforresource": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ],
   "name": "ListTagsForResource",
   "resources": [
    "pipe"
   ]
  },
  "startpipe": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ],
   "flags": [
    "IsWrite"
   ],
   "name": "StartPipe",
   "resources": [
    "pipe"
   ]
  },
  "stoppipe": {
   "conditionKeys": [
    "aws:ResourceTag/${TagKey}"
   ],
   "flags": [
    "IsWrite"
   ],
   "name": "StopPipe",
   "resources": [
    "pipe"
   ]
  },
  "tagresource": {
   "conditionKeys": [
    "aws:RequestTag/${TagKey}",
    "aws:ResourceTag/${TagKey}",
