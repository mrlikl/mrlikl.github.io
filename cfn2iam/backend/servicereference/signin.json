    "oauth2-resource-service-principal": [
     "signin:OAuthClientAuthentication",
     "signin:OAuthClientId",
     "signin:OAuthGrantType",
     "signin:OAuthRedirectUri"
    ]
   },
   "resources": [
    "console",
    "oauth2-public-client-localhost",
    "oauth2-public-client-remote",
    "oauth2-resource-service-principal"
