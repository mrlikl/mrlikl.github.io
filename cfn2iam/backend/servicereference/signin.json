  "putconsoleauthorizationconfiguration": {
   "flags": [
    "IsWrite"
   ],
   "name": "PutConsoleAuthorizationConfiguration",
   "resources": []
  },
  "putresourcepermissionstatement": {
   "flags": [
    "IsWrite"
   ],
   "name": "PutResourcePermissionStatement",
   "resources": []
