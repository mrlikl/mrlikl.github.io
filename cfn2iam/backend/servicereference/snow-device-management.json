   "flags": [
    "IsList"
   ],
   "name": "ListTasks",
   "resources": []
  },
  "tagresource": {
   "conditionKeys": [
    "aws:RequestTag/${TagKey}",
    "aws:TagKeys"
   ],
   "flags": [
    "IsTaggingOnly",
    "IsWrite"
   ],
   "name": "TagResource",
   "resources": [
    "managed-device",
    "task"
   ]
  },
  "untagresource": {
   "conditionKeys": [
    "aws:TagKeys"
   ],
   "flags": [
    "IsTaggingOnly",
    "IsWrite"
   ],
   "name": "UntagResource",
   "resources": [
    "managed-device",
    "task"
   ]
  }
