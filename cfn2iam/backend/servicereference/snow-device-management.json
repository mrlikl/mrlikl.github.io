   ]
  },
  "describedeviceec2instances": {
   "name": "DescribeDeviceEc2Instances",
   "resources": [
    "managed-device"
   ]
  },
  "describeexecution": {
   "name": "DescribeExecution",
   "resources": []
  },
  "describetask": {
   "name": "DescribeTask",
   "resources": [
    "task"
   ]
  },
  "listdeviceresources": {
   "flags": [
    "IsList"
   ],
   "name": "ListDeviceResources",
   "resources": [
    "managed-device"
   ]
  },
  "listdevices": {
   "flags": [
    "IsList"
   ],
   "name": "ListDevices",
   "resources": []
  },
  "listexecutions": {
   "flags": [
    "IsList"
   ],
   "name": "ListExecutions",
   "resources": []
  },
  "listtagsforresource": {
   "conditionKeys": [
    "aws:RequestTag/${TagKey}",
    "aws:TagKeys"
   ],
   "name": "ListTagsForResource",
   "resources": []
